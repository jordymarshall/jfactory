{
  "version": 1,
  "static": [
    "docs/**",
    "plan/**",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "static_suites": [
    "static"
  ],
  "always_suites": [
    "unit"
  ],
  "full_suites": [
    "unit",
    "smoke"
  ],
  "full_suite": "nightly",
  "pr_journeys": false,
  "force_independent": false,
  "shards": 4,
  "suites": {
    "static": {
      "run": "npm run lint",
      "minutes": 1
    },
    "unit": {
      "run": "npm test",
      "minutes": 3
    },
    "smoke": {
      "run": "npx playwright test e2e/smoke.spec.ts",
      "minutes": 1,
      "target": "local"
    },
    "browser-briefs": {
      "run": "npx playwright test e2e/briefs.spec.ts",
      "minutes": 4,
      "target": "local"
    },
    "browser-sign-in": {
      "run": "npx playwright test e2e/sign-in.spec.ts",
      "minutes": 3,
      "target": "local"
    },
    "browser-marketing": {
      "run": "npx playwright test e2e/marketing.spec.ts",
      "minutes": 2,
      "target": "local"
    }
  },
  "targets": {
    "local": {
      "setup": "npm ci && npx playwright install chromium",
      "doctor": "npm run doctor",
      "start": "npm run build && npm run start -- --port $PORT",
      "ready": "http://127.0.0.1:$PORT/api/health",
      "probe": "npx playwright test e2e/smoke.spec.ts",
      "auth": "Per-run test account created by seed; no human sign-in",
      "seed": "npm run test-data -- create --run $JFACTORY_RUN_ID",
      "cleanup": "npm run test-data -- delete --run $JFACTORY_RUN_ID",
      "prune": "npm run test-data -- delete --older-than 6h"
    },
    "preview": {
      "url": "Pass the PR preview with smoke --url",
      "ready": "$BASE_URL/api/health",
      "auth": "Vercel protection bypass token in VERCEL_AUTOMATION_BYPASS_SECRET; seeded test account"
    }
  },
  "features": {
    "save-brief": {
      "paths": [
        "outcomes/save-a-brief.md",
        "app/src/app/briefs/**",
        "app/e2e/briefs.spec.ts"
      ],
      "outcome": "outcomes/save-a-brief.md",
      "recipe": ".agents/skills/verify-app/features/save-brief.md",
      "suites": [
        "unit",
        "browser-briefs"
      ],
      "verify": "ci",
      "screens": false
    },
    "brief-storage": {
      "paths": [
        "app/src/lib/briefs/**"
      ],
      "outcome": "outcomes/save-a-brief.md",
      "recipe": ".agents/skills/verify-app/features/save-brief.md",
      "suites": [
        "unit",
        "browser-briefs"
      ],
      "verify": "independent"
    },
    "sign-in": {
      "paths": [
        "outcomes/sign-in.md",
        "app/src/lib/auth.ts",
        "app/src/app/(auth)/**",
        "app/e2e/sign-in.spec.ts"
      ],
      "outcome": "outcomes/sign-in.md",
      "recipe": ".agents/skills/verify-app/features/sign-in.md",
      "suites": [
        "unit",
        "browser-sign-in"
      ],
      "verify": "independent"
    },
    "shared-data": {
      "paths": [
        "app/src/lib/db/**",
        "app/src/lib/api-client.ts"
      ],
      "recipe": "Run the unit suite's data-layer tests; recorded coverage adds the journeys that execute the changed file",
      "suites": [
        "unit",
        "smoke"
      ],
      "verify": "independent"
    },
    "build-and-dependencies": {
      "paths": [
        "package.json",
        "package-lock.json",
        "app/next.config.*",
        "app/tsconfig.json",
        "app/e2e/smoke.spec.ts",
        "app/playwright.config.ts"
      ],
      "recipe": "Build, run the unit suite and the smoke journey; journeys the change does not select run only in a whole-suite run (full_suite)",
      "suites": [
        "unit",
        "smoke"
      ],
      "verify": "independent"
    },
    "marketing-pages": {
      "paths": [
        "app/src/app/(marketing)/**",
        "app/src/components/marketing/**"
      ],
      "outcome": "outcomes/understand-the-product.md",
      "recipe": "Review the diff against the outcome, the copy and design standards, and screenshots of each changed page at desktop and phone",
      "suites": [
        "unit",
        "browser-marketing"
      ],
      "verify": "ci",
      "screens": false
    },
    "internal-tooling": {
      "paths": [
        "scripts/**",
        "app/src/lib/logging/**"
      ],
      "recipe": "Run the unit suite; these files do not change what users see or store",
      "suites": [
        "unit"
      ],
      "verify": "ci"
    }
  }
}
